# PORT: Dev and production server port
PORT=3000

# NODE_ENV: Environment mode (development/production)
NODE_ENV="development"

# APP_URL: Public or local URL of the app
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret for signing session cookies / JWT tokens
SESSION_SECRET="tuition-bd-secret-key-salt-change-in-prod"

# DATA_DIR: Local directory for database persistence
DATA_DIR="./data"

# UPLOAD_DIR: Directory for bKash QR codes and payment receipts
UPLOAD_DIR="./uploads"
